{
  "id": "databases",
  "name": "Databases",
  "version": "1.1.0",
  "description": "Browse and edit MySQL, MariaDB, PostgreSQL and SQLite databases on your hosts from one tab.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Databases",
  "docs": "https://docs.termix.site/plugins/databases",
  "video": "https://www.youtube.com/watch?v=FZ7QuMcDjKM",
  "category": "Infrastructure",
  "icon": "Database",
  "features": [
    "Save database logins per host with sealed passwords",
    "Browse databases, tables and views",
    "Page, sort and filter table data",
    "Add, edit and delete rows by primary key",
    "See columns, types and indexes",
    "Run SQL in a console and export results as CSV or JSON",
    "A databases panel beside any SSH terminal"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.10.3",
    "api": "^1.5"
  },
  "capabilities": [
    "hosts:read",
    "credentials:use",
    "ssh:connect",
    "network:serve",
    "ui:surface",
    "db:own",
    "secrets:own"
  ],
  "contributes": {
    "tabs": [
      {
        "id": "databases",
        "titleKey": "tab.title",
        "icon": "Database",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "host": {
        "enableKey": "enableDatabases",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "enableDefault": false,
        "editorGroup": "ssh",
        "fields": [
          {
            "key": "showPanel",
            "type": "boolean",
            "labelKey": "settings.host.showPanel.label",
            "descriptionKey": "settings.host.showPanel.description",
            "default": true,
            "requires": "enableDatabases"
          }
        ]
      },
      "user": [
        {
          "key": "companionAutoOpen",
          "type": "boolean",
          "labelKey": "settings.user.companionAutoOpen.label",
          "descriptionKey": "settings.user.companionAutoOpen.description",
          "default": false
        },
        {
          "key": "companionSide",
          "type": "select",
          "labelKey": "settings.user.companionSide.label",
          "descriptionKey": "settings.user.companionSide.description",
          "default": "right",
          "options": [
            {
              "value": "right",
              "labelKey": "settings.user.companionSide.right"
            },
            {
              "value": "left",
              "labelKey": "settings.user.companionSide.left"
            },
            {
              "value": "bottom",
              "labelKey": "settings.user.companionSide.bottom"
            }
          ]
        },
        {
          "key": "companionSize",
          "type": "number",
          "labelKey": "settings.user.companionSize.label",
          "descriptionKey": "settings.user.companionSize.description",
          "min": 240,
          "max": 900,
          "default": 480
        },
        {
          "key": "companionEdgeButton",
          "type": "boolean",
          "labelKey": "settings.user.companionEdgeButton.label",
          "descriptionKey": "settings.user.companionEdgeButton.description",
          "default": true
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
